{
  "$defs": {
    "Address": {
      "description": "A postal address as returned by Companies House.\n\nAll fields except `country` are optional because CH addresses are\ninconsistently populated (e.g. `premises` is often absent for older\nfilings).",
      "example": {
        "address_line_1": "High Street",
        "address_line_2": null,
        "country": "England",
        "locality": "London",
        "postal_code": "EC1A 1AA",
        "premises": "1",
        "region": null
      },
      "properties": {
        "address_line_1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address Line 1"
        },
        "address_line_2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address Line 2"
        },
        "country": {
          "default": "United Kingdom",
          "title": "Country",
          "type": "string"
        },
        "locality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Town/city.",
          "title": "Locality"
        },
        "postal_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postal Code"
        },
        "premises": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Building name/number.",
          "title": "Premises"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "title": "Address",
      "type": "object"
    },
    "CompanyStatus": {
      "description": "Companies House `company_status` values we care about.\n\nNot exhaustive of every value CH can return (e.g. \"converted-closed\"),\nbut covers the ones that affect scoring logic. Unknown values from the\nAPI should be mapped to OTHER rather than raising.",
      "enum": [
        "active",
        "dissolved",
        "liquidation",
        "receivership",
        "administration",
        "voluntary-arrangement",
        "other"
      ],
      "title": "CompanyStatus",
      "type": "string"
    },
    "FilingHistorySummary": {
      "description": "Rolled-up view of a company's filing compliance, used by ApplicantProfile.",
      "example": {
        "last_accounts_made_up_to": "2024-03-31",
        "last_confirmation_statement_date": "2024-06-01",
        "late_filings_count": 1,
        "next_accounts_due_on": "2025-12-31",
        "total_filings": 12
      },
      "properties": {
        "last_accounts_made_up_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Accounts Made Up To"
        },
        "last_confirmation_statement_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Confirmation Statement Date"
        },
        "late_filings_count": {
          "default": 0,
          "minimum": 0,
          "title": "Late Filings Count",
          "type": "integer"
        },
        "next_accounts_due_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Accounts Due On"
        },
        "total_filings": {
          "default": 0,
          "minimum": 0,
          "title": "Total Filings",
          "type": "integer"
        }
      },
      "title": "FilingHistorySummary",
      "type": "object"
    },
    "OfficerSummary": {
      "description": "One director/officer as they appear on this company's record.\n\nDeliberately thin \u2014 full history (other appointments, dissolved\ncompanies, etc.) lives in `DirectorFeatureSet`, keyed by `officer_id`.\nThis is just \"who is on this company today/historically\".",
      "example": {
        "appointed_on": "2018-05-14",
        "name": "SMITH, John Michael",
        "nationality": "British",
        "occupation": "Company Director",
        "officer_id": "abc123def456ghi789",
        "resigned_on": null,
        "role": "director"
      },
      "properties": {
        "appointed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Appointed On"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nationality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nationality"
        },
        "occupation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupation"
        },
        "officer_id": {
          "description": "Companies House officer/appointment ID.",
          "title": "Officer Id",
          "type": "string"
        },
        "resigned_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resigned On"
        },
        "role": {
          "description": "e.g. 'director', 'secretary'.",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "officer_id",
        "name",
        "role"
      ],
      "title": "OfficerSummary",
      "type": "object"
    }
  },
  "description": "Normalized company profile assembled from the Companies House API.\n\nProduced by `ingestion.build_applicant_profile(company_number)`. Every\nother contract in the pipeline either derives from this directly\n(financials, director features) or references its `company_number`.",
  "example": {
    "accounts_overdue": false,
    "company_name": "HEALTHY EXAMPLE PLC",
    "company_number": "01234567",
    "data_completeness": 0.95,
    "filing_history": {
      "last_accounts_made_up_to": "2024-03-31",
      "last_confirmation_statement_date": "2024-06-01",
      "late_filings_count": 0,
      "next_accounts_due_on": "2025-12-31",
      "total_filings": 12
    },
    "incorporation_date": "2005-03-11",
    "officers": [],
    "registered_address": {
      "address_line_1": "High Street",
      "address_line_2": null,
      "country": "England",
      "locality": "London",
      "postal_code": "EC1A 1AA",
      "premises": "1",
      "region": null
    },
    "sic_codes": [
      "62012",
      "62020"
    ],
    "status": "active"
  },
  "properties": {
    "accounts_overdue": {
      "default": false,
      "title": "Accounts Overdue",
      "type": "boolean"
    },
    "company_name": {
      "title": "Company Name",
      "type": "string"
    },
    "company_number": {
      "description": "8-character CH company number, as filed (may have leading zeros).",
      "title": "Company Number",
      "type": "string"
    },
    "data_completeness": {
      "description": "Fraction of expected profile fields CH actually returned. Feeds into RedFlag/ScoreBreakdown confidence, not just a UI hint.",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Data Completeness",
      "type": "number"
    },
    "filing_history": {
      "$ref": "#/$defs/FilingHistorySummary"
    },
    "incorporation_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Incorporation Date"
    },
    "officers": {
      "items": {
        "$ref": "#/$defs/OfficerSummary"
      },
      "title": "Officers",
      "type": "array"
    },
    "registered_address": {
      "$ref": "#/$defs/Address"
    },
    "sic_codes": {
      "description": "UK SIC 2007 codes.",
      "items": {
        "type": "string"
      },
      "title": "Sic Codes",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/CompanyStatus"
    }
  },
  "required": [
    "company_number",
    "company_name",
    "status",
    "registered_address",
    "data_completeness"
  ],
  "title": "ApplicantProfile",
  "type": "object"
}
