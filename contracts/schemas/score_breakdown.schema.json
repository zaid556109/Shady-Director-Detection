{
  "$defs": {
    "ClusterSubscores": {
      "description": "The two feature clusters' contribution to the total, each 0-100\nbefore weighting \u2014 kept separate so the UI can show two panels.",
      "example": {
        "financial": 74.0,
        "governance": 82.0
      },
      "properties": {
        "financial": {
          "maximum": 100,
          "minimum": 0,
          "title": "Financial",
          "type": "number"
        },
        "governance": {
          "maximum": 100,
          "minimum": 0,
          "title": "Governance",
          "type": "number"
        }
      },
      "required": [
        "governance",
        "financial"
      ],
      "title": "ClusterSubscores",
      "type": "object"
    },
    "EvidenceRef": {
      "description": "A pointer back to the specific filing/officer record backing a RedFlag.\n\nKept generic (`source_type` + `source_id`) rather than a union of\nconcrete refs so RedFlag doesn't need to change shape as new evidence\nsources (e.g. PSC data) get added later.",
      "example": {
        "detail": "2 dissolved companies in the last 5 years",
        "source_id": "abc123def456",
        "source_type": "officer"
      },
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable pointer, e.g. filing date.",
          "title": "Detail"
        },
        "source_id": {
          "description": "ID of the record within source_type.",
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "description": "e.g. 'filing', 'officer', 'appointment'.",
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FeatureContribution": {
      "description": "How much one feature moved the total score, in either direction.",
      "example": {
        "feature_name": "current_ratio",
        "points": 12.0,
        "weight": 0.15
      },
      "properties": {
        "feature_name": {
          "title": "Feature Name",
          "type": "string"
        },
        "points": {
          "description": "Signed points contributed to the 0-100 total (can be negative).",
          "title": "Points",
          "type": "number"
        },
        "weight": {
          "description": "Configured weight for this feature, 0-1.",
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "feature_name",
        "weight",
        "points"
      ],
      "title": "FeatureContribution",
      "type": "object"
    },
    "RedFlag": {
      "description": "A single explainable red flag with traceable evidence.",
      "example": {
        "category": "governance",
        "evidence": [
          {
            "detail": "2 dissolved companies in the last 5 years",
            "source_id": "abc123def456ghi789",
            "source_type": "officer"
          }
        ],
        "human_label": "A director has 2 previously dissolved companies",
        "id": "dissolved-companies-2",
        "severity": "warning"
      },
      "properties": {
        "category": {
          "$ref": "#/$defs/RedFlagCategory"
        },
        "evidence": {
          "description": "At least one item in production; empty only in placeholder mocks.",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "human_label": {
          "description": "Short, UI-ready description of the flag.",
          "title": "Human Label",
          "type": "string"
        },
        "id": {
          "description": "Stable slug, unique within one assessment (not globally).",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "id",
        "severity",
        "category",
        "human_label"
      ],
      "title": "RedFlag",
      "type": "object"
    },
    "RedFlagCategory": {
      "enum": [
        "governance",
        "financial",
        "filing"
      ],
      "title": "RedFlagCategory",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "description": "Final 0-100 reliability score plus a full explainable breakdown.",
  "example": {
    "cluster_subscores": {
      "financial": 74.0,
      "governance": 82.0
    },
    "company_number": "01234567",
    "explanation": "Strong current ratio and clean director history offset moderate gearing.",
    "feature_contributions": [
      {
        "feature_name": "current_ratio",
        "points": 12.0,
        "weight": 0.15
      },
      {
        "feature_name": "disqualification_flag",
        "points": 0.0,
        "weight": 0.25
      }
    ],
    "flags": [],
    "generated_at": "2026-08-10T12:00:00Z",
    "total": 78
  },
  "properties": {
    "cluster_subscores": {
      "$ref": "#/$defs/ClusterSubscores"
    },
    "company_number": {
      "title": "Company Number",
      "type": "string"
    },
    "explanation": {
      "description": "Short human-readable summary of the total score.",
      "title": "Explanation",
      "type": "string"
    },
    "feature_contributions": {
      "items": {
        "$ref": "#/$defs/FeatureContribution"
      },
      "title": "Feature Contributions",
      "type": "array"
    },
    "flags": {
      "items": {
        "$ref": "#/$defs/RedFlag"
      },
      "title": "Flags",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "total": {
      "maximum": 100,
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "company_number",
    "total",
    "cluster_subscores",
    "explanation",
    "generated_at"
  ],
  "title": "ScoreBreakdown",
  "type": "object"
}
