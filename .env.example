# Copy this file to .env and fill in real values. Never commit .env.

# --- Companies House API ---
# Register a key at https://developer.company-information.service.gov.uk/
CH_API_KEY=changeme
CH_API_BASE_URL=https://api.company-information.service.gov.uk
CH_DOCUMENT_API_BASE_URL=https://document-api.company-information.service.gov.uk
# CH allows 600 requests / 5 minutes per API key. See backend/app/ingestion/client.py.
CH_RATE_LIMIT_REQUESTS=600
CH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Database ---
DATABASE_URL=postgresql+psycopg://counterparty:counterparty@localhost:5432/counterparty_check
POSTGRES_USER=counterparty
POSTGRES_PASSWORD=counterparty
POSTGRES_DB=counterparty_check
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_PORT=6379

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Use mock data instead of real CH calls / real scoring. Keep true until modules land.
USE_MOCK_PIPELINE=true

# --- Frontend (frontend/.env.example mirrors this) ---
VITE_API_BASE_URL=http://localhost:8000
